{"entries":[{"timestamp":1791926156533,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":1191,"diffs":[[1,"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"device_forever\"></block>\n</xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":219,"diffs":[[1,"\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":114,"length1":83,"diffs":[[1,"        \"microphone\": \"*\"\n"]]},{"start1":204,"length1":41,"diffs":[[1,"        \"README.md\"\n"]]},{"start1":231,"length1":35,"diffs":[[1,"    \"additionalFilePaths\": []\n"]]}]},{"type":"added","filename":"custom.ts","value":"//% weight=100 color=#E5007D icon=\"\\uf001\"\n//% block=\"MP3 Grove v3\"\nnamespace mp3v3 {\n    function envoyer(cmd: number, data: number[]) {\n        let len = data.length + 3\n        let somme = len + cmd\n        let buf = [0x7E, len, cmd]\n        for (let d of data) {\n            buf.push(d)\n            somme += d\n        }\n        buf.push(somme & 0xFF)\n        buf.push(0xEF)\n        serial.writeBuffer(Buffer.fromArray(buf))\n    }\n    //% block=\"MP3 initialiser TX %tx RX %rx\"\n    //% tx.defl=SerialPin.P1 rx.defl=SerialPin.P0\n    export function initialiser(tx: SerialPin, rx:\n        SerialPin) {\n        serial.redirect(tx, rx, BaudRate.BaudRate9600)\n        basic.pause(2000)\n    }\n    //% block=\"MP3 volume %v\"\n    //% v.min=0 v.max=31 v.defl=20\n    export function volume(v: number) {\n        envoyer(0xAE, [v])\n        basic.pause(300)\n    }\n    //% block=\"MP3 jouer la piste %n\"\n    //% n.min=1 n.max=255 n.defl=1\n    export function jouer(n: number) {\n        envoyer(0xA2, [0, n])\n    }\n    //% block=\"MP3 arrêter\"\n    export function arreter() {\n        envoyer(0xAB, [])\n    }\n}\n"}]},{"timestamp":1791926751072,"editorVersion":"9.0.12","changes":[{"type":"edited","filename":"main.blocks","patch":[{"start1":0,"length1":2157,"diffs":[[1,"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables></variables><block type=\"pxt-on-start\" x=\"-281\" y=\"-351\"><statement name=\"HANDLER\"><block type=\"mp3v3_initialiser\"><field name=\"tx\">SerialPin.P1</field><field name=\"rx\">SerialPin.P0</field><next><block type=\"mp3v3_volume\"><value name=\"v\"><shadow type=\"math_number_minmax\"><mutation min=\"0\" max=\"31\" label=\"V\" precision=\"0\"></mutation><field name=\"SLIDER\">20</field></shadow></value></block></next></block></statement></block><block type=\"device_forever\" x=\"-296\" y=\"-139\"><statement name=\"HANDLER\"><block type=\"controls_if\"><mutation else=\"1\"></mutation><value name=\"IF0\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">TRUE</field></shadow><block type=\"logic_compare\"><field name=\"OP\">LT</field><value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"grove_ultrasonic_centimeters_v2\"><field name=\"pin\">DigitalPin.P2</field></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">10</field></shadow></value></block></value><statement name=\"DO0\"><block type=\"basic_show_icon\"><field name=\"i\">IconNames.Heart</field></block></statement></block></statement></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":151,"length1":87,"diffs":[[1,"        basic.showIcon(IconNames.Heart)\n"]]},{"start1":204,"length1":65,"diffs":[[1,"    \t\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":2,"length1":42,"diffs":[[1,"    \"name\": \"Sonfinal\",\n"]]},{"start1":309,"length1":44,"diffs":[[1,""]]}]},{"type":"added","filename":"test.ts","value":"// les tests vont ici ; cela ne sera pas compilé si ce paquet est utilisé en tant qu'extension.\n"}]}],"snapshots":[{"timestamp":1791926156532,"editorVersion":"9.0.12","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <block type=\"pxt-on-start\"></block>\n  <block type=\"dev